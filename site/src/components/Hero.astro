---
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">Introducing Infracost Dev</div>
        <h1>Cloud cost awareness for your <span class="accent">coding agent</span> or IDE</h1>
        <p class="hero-sub">
          Install in minutes and eliminate cloud waste from your IaC configurations — before you go to PR review.
        </p>
        <div class="hero-ctas">
          <a href="https://www.infracost.io/docs/" class="btn btn-primary">
            Get started free
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <div class="hero-trust">No credit card · 1,000+ services supported</div>
      </div>

      <div class="video-box">
        <wistia-player media-id="xc04fn0eoc" aspect="1.7777777777777777"></wistia-player>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 80px 0 96px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .eyebrow {
    font-family: "Zalando Sans", serif;
    font-style: italic;
    font-weight: 400;
    font-size: 16px;
    color: var(--cyan);
    margin-bottom: 20px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 56px;
    line-height: 1.07;
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }
  .hero h1 .accent {
    color: var(--pink);
  }
  .hero-sub {
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 36px;
    max-width: 520px;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-trust {
    margin-top: 28px;
    font-size: 13px;
    color: var(--text-tertiary);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .video-box {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--panel);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    overflow: hidden;
  }
  .video-box wistia-player {
    width: 100%;
    height: 100%;
    display: block;
  }
  wistia-player[media-id="xc04fn0eoc"]:not(:defined) {
    background: center / contain no-repeat
      url("https://fast.wistia.com/embed/medias/xc04fn0eoc/swatch");
    display: block;
    filter: blur(5px);
    padding-top: 56.25%;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 56px 0;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .hero h1 {
      font-size: 40px;
    }
  }
</style>

<script is:inline async src="https://fast.wistia.com/player.js"></script>
<script is:inline async type="module" src="https://fast.wistia.com/embed/xc04fn0eoc.js"></script>
